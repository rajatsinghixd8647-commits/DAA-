#include <stdio.h>

int removeDuplicates(int arr[], int n)
{
    if (n == 0)
        return 0;

    int k = 1;

    for (int i = 1; i < n; i++)
    {
        if (arr[i] != arr[i - 1])
        {
            arr[k] = arr[i];
            k++;
        }
    }

    return k;
}

int main()
{
    int arr[] = {1, 1, 2, 3, 3, 3, 4};
    int n = 7;

    int k = removeDuplicates(arr, n);

    printf("Output: [");
    for (int i = 0; i < k; i++)
    {
        printf("%d", arr[i]);
        if (i < k - 1)
            printf(", ");
    }
    printf("]");

    return 0;
}
