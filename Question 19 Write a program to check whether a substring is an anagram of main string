#include <stdio.h>
#include <string.h>

int main()
{
    char a[100], b[100];
    int count[26] = {0};

    scanf("%s", a);
    scanf("%s", b);

    if (strlen(a) != strlen(b))
    {
        printf("Not Anagram");
        return 0;
    }

    for (int i = 0; a[i] != '\0'; i++)
    {
        count[a[i] - 'a']++;
        count[b[i] - 'a']--;
    }

    for (int i = 0; i < 26; i++)
    {
        if (count[i] != 0)
        {
            printf("Not Anagram");
            return 0;
        }
    }

    printf("Anagram");

    return 0;
}
