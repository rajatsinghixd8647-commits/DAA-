#include <stdio.h>

int main()
{
    int a[] = {-4, -3, -5, 1, 2, 3};
    int n = 6;
    int result[6];
    int i, left = 0, right = n - 1, pos = n - 1;
    int leftSquare, rightSquare;

    while (left <= right)
    {
        leftSquare = a[left] * a[left];
        rightSquare = a[right] * a[right];

        if (leftSquare > rightSquare)
        {
            result[pos] = leftSquare;
            left++;
        }
        else
        {
            result[pos] = rightSquare;
            right--;
        }

        pos--;
    }

    printf("Output: ");

    for (i = 0; i < n; i++)
    {
        printf("%d ", result[i]);
    }

    return 0;
}
