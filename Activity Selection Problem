#include <stdio.h>

typedef struct {
    char name;
    int start;
    int finish;
} Activity;

// Sort activities according to finish time
void sortByFinish(Activity activities[], int n) {

    for (int i = 0; i < n - 1; i++) {

        for (int j = i + 1; j < n; j++) {

            if (activities[i].finish > activities[j].finish) {

                Activity temp = activities[i];
                activities[i] = activities[j];
                activities[j] = temp;
            }
        }
    }
}

int main() {

    Activity activities[] = {
        {'A', 1, 2},
        {'B', 3, 4},
        {'C', 0, 6},
        {'D', 5, 7},
        {'E', 8, 9},
        {'F', 5, 9}
    };

    int n = sizeof(activities) / sizeof(activities[0]);

    // Sort according to finish time
    sortByFinish(activities, n);

    printf("Activity Selection Problem\n");
    printf("==========================\n\n");

    printf("Selected Activities:\n");

    // Select first activity
    int lastFinish = activities[0].finish;

    printf("Activity %c (%d - %d)\n",
           activities[0].name,
           activities[0].start,
           activities[0].finish);

    int count = 1;

    // Select remaining activities
    for (int i = 1; i < n; i++) {

        if (activities[i].start >= lastFinish) {

            printf("Activity %c (%d - %d)\n",
                   activities[i].name,
                   activities[i].start,
                   activities[i].finish);

            lastFinish = activities[i].finish;
            count++;
        }
    }

    printf("\nMaximum number of activities = %d\n", count);

    return 0;
}
